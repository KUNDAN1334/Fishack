# Fishly configuration template. Copy to .env and fill in keys:
#   cp .env.example .env
# Every value here has a default in app/config.py — this file only needs the
# secrets and whatever you want to override.

# ------------------------------------------------------------------ infra --
# Defaults assume `docker compose up` with the API running LOCALLY (make api).
# The api container overrides these to use compose service hostnames.
DATABASE_URL=postgresql://fishly:fishly@localhost:5432/fishly
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------- LLM providers (all FREE tiers) --
# Fallback chain order — first configured provider wins, on rate-limit/outage
# we fail over to the next (this IS the multi-provider resilience pattern).
LLM_PROVIDER_ORDER=groq,gemini,openrouter,ollama

# Groq — free key at https://console.groq.com/keys
# Free tier (July 2026): ~14,400 req/day on small models, ~1,000 req/day on
# large ones. Model lineups change often — verify current IDs at
# https://console.groq.com/docs/models (smoke_test.py will tell you fast).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini — free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — free key at https://openrouter.ai/keys (no card needed)
# Free models are suffixed ":free" (~20 req/min, ~50-200 req/day). Browse:
# https://openrouter.ai/collections/free-models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama — optional local fallback, OFF by default (needs a machine that can
# run a 7-8B model). Enable after: docker compose --profile ollama up -d
#          docker compose exec ollama ollama pull llama3.1:8b
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ----------------------------------------------------------- generation ----
# Low temperature for factual support answers (Design.md §7: 0.0-0.2)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------- retries -----
# Exponential backoff on 429/5xx before failing over to the next provider
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0

# ----------------------------------------------------------- embeddings ----
# Local, free, deterministic. bge-small = 384 dims (matches the DB schema —
# switching to bge-base/768 requires a migration + full re-ingest, see ADR-005)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
